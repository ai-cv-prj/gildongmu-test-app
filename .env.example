APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=backend/data
MODEL_DIR=backend/models
SAVE_FRAMES=true
MAX_UPLOAD_BYTES=2097152
MIN_FREE_DISK_GB=2

# Walking only. Restart the server after changes.
WALKING_RISK_ENABLED=true
WALKING_RISK_CONFIG=backend/config/walking_risk.yaml
WALKING_MASK_WEIGHTS=backend/models/walking_aux/mask2former
WALKING_PRECISION=fp32
# Optional absolute path to a Korean TrueType/OpenType font.
WALKING_FONT_PATH=
